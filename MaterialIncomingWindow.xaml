<Window x:Class="LashAccountingSystem.MaterialIncomingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📦 Пополнение материала" 
        Height="450" Width="450"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="📦 Пополнение материала" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Выбор материала -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Материал:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <ComboBox x:Name="MaterialComboBox" 
                  Grid.Row="1" Grid.Column="1" 
                  Height="35" 
                  Margin="5"
                  DisplayMemberPath="MaterialName"
                  SelectedValuePath="MaterialId"
                  SelectionChanged="MaterialComboBox_SelectionChanged"/>

        <!-- Текущий остаток -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Текущий остаток:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontSize="14"/>
        <TextBlock x:Name="CurrentStockText" 
                   Grid.Row="2" Grid.Column="1" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontSize="14"
                   Foreground="#8F9964"
                   FontWeight="Bold"/>

        <!-- Количество -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Количество:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <TextBox x:Name="QuantityTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Height="35" 
                 Margin="5"/>

        <!-- Цена закупки -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Цена за ед.:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontSize="14"/>
        <TextBox x:Name="PriceTextBox" 
                 Grid.Row="4" Grid.Column="1" 
                 Height="35" 
                 Margin="5"
                 ToolTip="Цена, по которой закуплен материал"/>

        <!-- Поставщик -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Text="Поставщик:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontSize="14"/>
        <TextBox x:Name="SupplierTextBox" 
                 Grid.Row="5" Grid.Column="1" 
                 Height="35" 
                 Margin="5"
                 ToolTip="У кого закуплен материал"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="AddButton" 
                    Content="✅ Добавить" 
                    Width="100" Height="35" 
                    Background="#3D5736" 
                    Foreground="White"
                    Click="AddButton_Click"/>
            <Button x:Name="CancelButton" 
                    Content="❌ Отмена" 
                    Width="100" Height="35" 
                    Margin="10,0,0,0"
                    Background="#B35D6E" 
                    Foreground="White"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" 
                   Text="* — обязательные поля" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>