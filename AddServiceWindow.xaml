<Window x:Class="LashAccountingSystem.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление услуги" 
        Height="500" Width="700"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0" 
                   Text="Новая услуга" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center" Grid.Column="1" Width="178"/>

        <!-- Название услуги -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Название услуги:" 
                   VerticalAlignment="Center" 
                   Margin="5,0,5,0" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14" Height="16"/>
        <TextBox x:Name="NameTextBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Margin="5,5,5,5"/>

        <!-- Длительность -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Длительность (мин):" 
                   VerticalAlignment="Center" 
                   Margin="5,0,5,0" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14" Height="17"/>
        <TextBox x:Name="DurationTextBox" 
                 Grid.Row="2" Grid.Column="1" 
                 Margin="5,5,5,5"/>

        <!-- Цена -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Цена (руб):" 
                   VerticalAlignment="Center" 
                   Margin="5,0,5,0" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14" Height="16"/>
        <TextBox x:Name="PriceTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Margin="5,5,5,5"/>

        <!-- Описание -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Описание:" 
                   VerticalAlignment="Center" 
                   Margin="5,5,5,0"
                   Foreground="#3D5736"
                   FontSize="14" Height="17"/>
        <TextBox x:Name="DescriptionTextBox" 
                 Grid.Row="4" Grid.Column="1" 
                 Margin="5,5,5,5" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10" Grid.Column="1" Width="280">
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="6" 
                   Text="ℹ️ Поля, выделенные жирным, обязательны для заполнения" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="0,10,0,0" 
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center" Grid.Column="1" Height="12" Width="282"/>
    </Grid>
</Window>