<Window x:Class="LashAccountingSystem.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление услуги" 
        Height="650" Width="700"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="➕ Новая услуга" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Название услуги -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Название услуги:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="NameTextBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Height="35"/>

        <!-- Длительность -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Длительность (мин):" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="DurationTextBox" 
                 Grid.Row="2" Grid.Column="1" 
                 Height="35"/>

        <!-- Цена -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Цена (руб):" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="PriceTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Height="35"/>

        <!-- Описание -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Описание:" 
                   VerticalAlignment="Top" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="DescriptionTextBox" 
                 Grid.Row="4" Grid.Column="1" 
                 Height="80" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Секция материалов -->
        <Border Grid.Row="5" Grid.ColumnSpan="2" 
                Background="#FDF0F4" 
                CornerRadius="8" 
                Padding="10" 
                Margin="5,10,5,10"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="📦 Необходимые материалы" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="#3D5736"
                               VerticalAlignment="Center"/>
                    <Button x:Name="AddMaterialButton" 
                            Content="➕ Добавить материал" 
                            Width="140" Height="30" 
                            Margin="20,0,0,0"
                            Background="#3D5736" 
                            Foreground="White"
                            Click="AddMaterialButton_Click"/>
                </StackPanel>

                <DataGrid x:Name="MaterialsDataGrid" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MaxHeight="150"
                          Margin="0,10,0,0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding QuantityRequired}" Width="100"/>
                        <DataGridTemplateColumn Header="Действия" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" 
                                            Width="30" Height="25"
                                            Background="#B35D6E" Foreground="White"
                                            Click="DeleteMaterialButton_Click"
                                            Tag="{Binding TempId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="120" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="120" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" 
                   Text="ℹ️ Поля, выделенные жирным, обязательны для заполнения" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>