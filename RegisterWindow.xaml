<Window x:Class="LashAccountingSystem.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 Регистрация" 
        Height="400" Width="450"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Регистрация нового пользователя" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Логин:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="35" Padding="8,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Пароль:" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="8,5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Подтверждение пароля:" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="35" Padding="8,5"/>
        </StackPanel>

        <Border Grid.Row="4" Background="#FFE0E0" CornerRadius="4" Padding="5" Margin="0,10,0,0" 
                x:Name="ErrorBorder" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Width="160" Height="35" 
                    Margin="10" Background="#3D5736" Foreground="White" Click="RegisterButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="35" 
                    Margin="10" Background="#B35D6E" Foreground="White" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>