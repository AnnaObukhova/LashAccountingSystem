<Window x:Class="LashAccountingSystem.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💾 Резервное копирование" 
        Height="450" Width="550"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="💾 Резервное копирование базы данных" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Информация -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ℹ️ Резервная копия создаётся в формате SQL-дампа" 
                           Foreground="#3D5736" FontSize="12"/>
                <TextBlock Text="📁 Файлы сохраняются в папке Documents\LashAccountingSystem\Backups" 
                           Foreground="#3D5736" FontSize="12" Margin="0,5,0,0"/>
                <TextBlock Text="🕐 Восстановление удалит текущие данные и заменит их из бэкапа" 
                           Foreground="#B35D6E" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="CreateBackupButton" 
                    Content="📀 Создать резервную копию" 
                    Width="180" Height="40"
                    Background="#3D5736" 
                    Foreground="White"
                    Click="CreateBackupButton_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="RestoreButton" 
                    Content="🔄 Восстановить из копии" 
                    Width="180" Height="40"
                    Background="#8F9964" 
                    Foreground="White"
                    Click="RestoreButton_Click"/>
        </StackPanel>

        <!-- Список бэкапов -->
        <TextBlock Grid.Row="3" 
                   Text="📋 Существующие резервные копии:" 
                   FontWeight="Bold" 
                   Margin="0,10,0,5"/>

        <Border Grid.Row="4" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <ListBox x:Name="BackupsListBox" 
                     SelectionMode="Single"
                     Height="150"
                     FontSize="14"
                     MouseDoubleClick="BackupsListBox_MouseDoubleClick"/>
        </Border>

        <!-- Подсказка -->
        <TextBlock Grid.Row="5" 
                   Text="💡 Двойной клик по файлу — восстановление из выбранной копии" 
                   FontSize="11" 
                   Foreground="#999999" 
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>

        <!-- Кнопка закрытия -->
        <Button x:Name="CloseButton" 
                Grid.Row="5"
                Content="Закрыть" 
                Width="100" Height="30"
                Background="#B35D6E" 
                Foreground="White"
                Click="CloseButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,0,0"/>
    </Grid>
</Window>