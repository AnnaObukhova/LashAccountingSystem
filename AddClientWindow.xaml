<Window x:Class="LashAccountingSystem.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление клиента" 
        Height="550" Width="700"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Новый клиент" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Фамилия -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Фамилия:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="SurnameTextBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Margin="5" Height="35"/>

        <!-- Имя -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Имя:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="NameTextBox" 
                 Grid.Row="2" Grid.Column="1" 
                 Margin="5" Height="35"/>

        <!-- Отчество -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Отчество:" 
                   VerticalAlignment="Center" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="PatronymicTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Margin="5" Height="35"/>

        <!-- Телефон -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Телефон:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="PhoneTextBox" 
                 Grid.Row="4" Grid.Column="1" 
                 Margin="5" Height="35"/>

        <!-- Email -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Text="Email:" 
                   VerticalAlignment="Center" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="EmailTextBox" 
                 Grid.Row="5" Grid.Column="1" 
                 Margin="5" Height="35"/>

        <!-- Примечания (особенности здоровья) -->
        <TextBlock Grid.Row="6" Grid.Column="0" 
                   Text="Примечания:" 
                   VerticalAlignment="Top" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="HealthTextBox" 
                 Grid.Row="6" Grid.Column="1" 
                 Margin="5" Height="80" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" 
                   Text="ℹ️ Поля, выделенные жирным, обязательны для заполнения" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>