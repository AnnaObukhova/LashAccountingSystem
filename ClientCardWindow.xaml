<Window x:Class="LashAccountingSystem.ClientCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка клиента" 
        Height="550" Width="700"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Карточка клиента" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Панель с информацией о клиенте -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ФИО -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="FullNameTextBlock" Grid.Row="0" Grid.Column="1" Margin="5" FontSize="14" FontWeight="Bold" Foreground="#B35D6E"/>

                <!-- Телефон -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="PhoneTextBlock" Grid.Row="1" Grid.Column="1" Margin="5" FontSize="14" Foreground="#3D5736"/>

                <!-- Email -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="EmailTextBlock" Grid.Row="2" Grid.Column="1" Margin="5" FontSize="14" Foreground="#3D5736"/>

                <!-- Примечания -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Примечания:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="NotesTextBlock" Grid.Row="3" Grid.Column="1" Margin="5" FontSize="14" Foreground="#3D5736" TextWrapping="Wrap"/>

                <!-- Всего посещений -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Всего посещений:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="TotalVisitsTextBlock" Grid.Row="4" Grid.Column="1" Margin="5" FontSize="14" FontWeight="Bold" Foreground="#8F9964"/>

                <!-- Общая сумма -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Общая сумма:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBlock x:Name="TotalAmountTextBlock" Grid.Row="5" Grid.Column="1" Margin="5" FontSize="14" FontWeight="Bold" Foreground="#8F9964"/>
            </Grid>
        </Border>

        <!-- История записей -->
        <TextBlock Grid.Row="2" 
                   Text="История посещений" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,10,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Таблица истории записей -->
        <Border Grid.Row="3" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <DataGrid x:Name="HistoryDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MaxHeight="250"
                      AlternatingRowBackground="#D2D5AB"
                      RowBackground="White"
                      FontSize="13"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="Background" Value="#FDF0F4"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding AppointmentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Время" Binding="{Binding AppointmentTime, StringFormat={}{0:hh\\:mm}}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Стоимость" Binding="{Binding ServicePrice, StringFormat={}{0:F2} ₽}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Статус" Binding="{Binding AppointmentStatus}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Выполнена">
                                        <Setter Property="Foreground" Value="#8F9964"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Отменена">
                                        <Setter Property="Foreground" Value="#B35D6E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Не явка">
                                        <Setter Property="Foreground" Value="#B35D6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Оплата" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌ Не оплачено"/>
                                            <Setter Property="Foreground" Value="#B35D6E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="True">
                                                    <Setter Property="Text" Value="✅ Оплачено"/>
                                                    <Setter Property="Foreground" Value="#8F9964"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="EditButton" Content="✏️ Редактировать" Width="120" Height="35" Margin="10" 
                    Background="#8F9964" Foreground="White" 
                    Click="EditButton_Click"/>
            <Button x:Name="CloseButton" Content="Закрыть" Width="100" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>