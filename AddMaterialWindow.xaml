<Window x:Class="LashAccountingSystem.AddMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление материала" 
        Height="580" Width="550"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Стиль для TextBox с переносом текста -->
        <Style TargetType="TextBox" x:Key="MultilineTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Новый материал" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Наименование -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Наименование:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="NameTextBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Height="35"/>

        <!-- Производитель -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Производитель:" 
                   VerticalAlignment="Center" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="ManufacturerTextBox" 
                 Grid.Row="2" Grid.Column="1" 
                 Height="35"/>

        <!-- Цена -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Цена (руб):" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="PriceTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Height="35"/>

        <!-- Начальный остаток -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Начальный остаток:" 
                   VerticalAlignment="Center" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="StockTextBox" 
                 Grid.Row="4" Grid.Column="1" 
                 Height="35"/>

        <!-- Противопоказания -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Text="Противопоказания:" 
                   VerticalAlignment="Top" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="ContraindicationsTextBox" 
                 Grid.Row="5" Grid.Column="1" 
                 Style="{StaticResource MultilineTextBox}"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="100" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="100" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>