<Window x:Class="LashAccountingSystem.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление материалами" 
        Height="550" Width="900"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Расходные материалы" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Button x:Name="AddButton" Content="➕ Добавить материал" Width="150" Height="35" 
            Margin="0,0,10,0" Background="#3D5736" Foreground="White" 
            Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="✏️ Редактировать" Width="120" Height="35" 
            Margin="0,0,10,0" Background="#8F9964" Foreground="White" 
            Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="🗑 Удалить" Width="100" Height="35" 
            Margin="0,0,10,0" Background="#B35D6E" Foreground="White" 
            Click="DeleteButton_Click"/>
            <Button x:Name="RefreshButton" Content="🔄 Обновить остатки" Width="130" Height="35" 
            Background="#8F9964" Foreground="White" 
            Click="RefreshButton_Click"/>

            <!-- НОВАЯ КНОПКА ПОПОЛНЕНИЯ -->
            <Button x:Name="IncomingButton" 
            Content="📦 Пополнение" 
            Width="120" Height="35"
            Background="#3D5736" 
            Foreground="White"
            Click="IncomingButton_Click"
            Margin="10,0,0,0"/>

            <!-- НОВАЯ КНОПКА РАСХОДА МАТЕРИАЛОВ -->
            <Button x:Name="MaterialConsumptionButton" 
            Content="📋 Расход материалов" 
            Width="140" Height="35"
            Background="#B35D6E" 
            Foreground="White"
            Click="MaterialConsumptionButton_Click"
            Margin="10,0,0,0"/>

            <Button x:Name="MaterialReportButton" 
            Content="📊 Отчёт по расходу" 
            Width="130" Height="35"
            Background="#8F9964" 
            Foreground="White"
            Click="MaterialReportButton_Click"
            Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Панель поиска -->
        <Border Grid.Row="2" 
                Background="#FDF0F4" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D7DAB3"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           Margin="0,0,10,0"/>

                <TextBox x:Name="SearchTextBox" 
                         Width="549" 
                         ToolTip="Введите наименование или производителя"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button x:Name="ClearSearchButton" 
                        Content="✖ Очистить" 
                        Width="80" 
                        Margin="10,0,0,0"
                        Background="#B35D6E" 
                        Foreground="White"
                        Click="ClearSearchButton_Click"/>

                <TextBlock x:Name="SearchResultCount" 
                           VerticalAlignment="Center" 
                           Margin="15,0,0,0"
                           Foreground="#8F9964"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Таблица материалов -->
        <Border Grid.Row="3" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <DataGrid x:Name="MaterialsDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#D2D5AB"
                      RowBackground="White"
                      FontSize="14"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="Background" Value="#FDF0F4"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" Binding="{Binding MaterialId}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Наименование -->
                    <DataGridTextColumn Header="Наименование" Binding="{Binding MaterialName}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Производитель -->
                    <DataGridTextColumn Header="Производитель" Binding="{Binding MaterialManufacturer}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Цена -->
                    <DataGridTextColumn Header="Цена (руб)" Binding="{Binding MaterialPrice, StringFormat={}{0:F2}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Остаток -->
                    <DataGridTextColumn Header="Остаток" Binding="{Binding MaterialStock, StringFormat={}{0:F2}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MaterialStock}" Value="0">
                                        <Setter Property="Foreground" Value="#B35D6E"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MaterialStock}" Value="10">
                                        <Setter Property="Foreground" Value="#8F9964"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Последний приход" Binding="{Binding LastIncomingDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding LastSupplier}" Width="120"/>
                    <DataGridTextColumn Header="Кол-во прихода" Binding="{Binding LastIncomingQuantity, StringFormat={}{0:F2}}" Width="90"/>
                    <DataGridTextColumn Header="Цена закупки" Binding="{Binding LastIncomingPrice, StringFormat={}{0:F2}}" Width="90"/>

                    
                    <!-- Противопоказания (растягивается) -->
                    <DataGridTextColumn Header="Противопоказания" Binding="{Binding MaterialContraindications}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Подсказка -->
        <TextBlock Grid.Row="4" 
                   Text="ℹ️ При остатке 0 материал выделяется красным, при остатке ≤ 10 — оливковым" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5,10,0,0" 
                   VerticalAlignment="Bottom"/>
    </Grid>
</Window>