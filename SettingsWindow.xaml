<Window x:Class="LashAccountingSystem.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Настройки" 
        Height="459" Width="610"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="⚙️ Настройки приложения" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Margin="0,0,0,15">
            <!-- Вкладка: Общие -->
            <TabItem Header="Общие">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="AutoBackupCheckBox" 
                              Grid.Row="0" 
                              Content="Автоматическое создание резервной копии при запуске"
                              Margin="0,5"/>

                    <CheckBox x:Name="ConfirmDeleteCheckBox" 
                              Grid.Row="1" 
                              Content="Подтверждать удаление записей"
                              IsChecked="True"
                              Margin="0,5"/>

                    <CheckBox x:Name="LowStockWarningCheckBox" 
                              Grid.Row="2" 
                              Content="Предупреждать о низком остатке материалов"
                              IsChecked="True"
                              Margin="0,5"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Порог остатка (ед.):" VerticalAlignment="Center" Width="140"/>
                        <TextBox x:Name="LowStockThresholdTextBox" Width="80" Text="5"/>
                    </StackPanel>

                    <Separator Grid.Row="4" Margin="0,10"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                        <TextBlock Text="Папка для бэкапов:" VerticalAlignment="Center" Width="140"/>
                        <TextBox x:Name="BackupPathTextBox" Width="230" Margin="5,0"/>
                        <Button x:Name="BrowseBackupButton" 
                                Content="📁 Обзор" 
                                Width="70"
                                Background="#8F9964" 
                                Foreground="White"
                                Click="BrowseBackupButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка: О программе -->
            <TabItem Header="О программе">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="LashAccountingSystem" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"
                                   Margin="0,10"/>
                        <TextBlock Text="Версия 1.0.0" 
                                   HorizontalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Text="Информационная система для автоматизации учета оказания услуг мастера по наращиванию ресниц" 
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,20"/>
                        <TextBlock Text="Разработчик: Обухова Анна Николаевна" 
                                   HorizontalAlignment="Center"
                                   Margin="0,10"/>
                        <TextBlock Text="© 2026" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="100" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="100" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
            <Button x:Name="ResetButton" Content="🔄 Сбросить" Width="100" Height="35" Margin="10" 
                    Background="#8F9964" Foreground="White" 
                    Click="ResetButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3" 
                   Text="Настройки сохраняются в файл config.txt" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>