<Window x:Class="LashAccountingSystem.MaterialConsumptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет расхода материалов" 
        Height="650" Width="950"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Учет расхода материалов" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Панель выбора записи -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Выберите запись:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="#3D5736"/>
                <ComboBox x:Name="AppointmentComboBox" 
                          Width="350" 
                          Height="35"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="AppointmentId"
                          SelectionChanged="AppointmentComboBox_SelectionChanged"/>
                <Button x:Name="RefreshButton" Content="🔄 Обновить" Width="90" Height="35" 
                        Margin="10,0,0,0" Background="#8F9964" Foreground="White" 
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Информация о выбранной записи -->
        <Border Grid.Row="2" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Клиент:" FontWeight="Bold" Margin="5" Foreground="#3D5736"/>
                <TextBlock x:Name="ClientNameText" Grid.Row="0" Grid.Column="1" Margin="5" Foreground="#3D5736"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Услуга:" FontWeight="Bold" Margin="5" Foreground="#3D5736"/>
                <TextBlock x:Name="ServiceNameText" Grid.Row="0" Grid.Column="3" Margin="5" Foreground="#3D5736"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата/Время:" FontWeight="Bold" Margin="5" Foreground="#3D5736"/>
                <TextBlock x:Name="DateTimeText" Grid.Row="1" Grid.Column="1" Margin="5" Foreground="#3D5736"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Статус:" FontWeight="Bold" Margin="5" Foreground="#3D5736"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="3" Margin="5" Foreground="#3D5736"/>
            </Grid>
        </Border>

        <!-- Панель добавления расхода -->
        <Border Grid.Row="3" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Материал:" FontWeight="Bold" Margin="5" VerticalAlignment="Center" Foreground="#3D5736"/>
                <ComboBox x:Name="MaterialComboBox" 
                          Grid.Row="0" Grid.Column="1" 
                          Margin="5" Height="35"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="MaterialId"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Количество:" FontWeight="Bold" Margin="5" VerticalAlignment="Center" Foreground="#3D5736"/>
                <TextBox x:Name="AmountTextBox" 
                         Grid.Row="0" Grid.Column="3" 
                         Margin="5" Height="35"
                         ToolTip="Например: 0.15 (литры) или 1 (штука)"/>

                <Button x:Name="AddButton" Content="➕ Добавить расход" 
                        Grid.Row="1" Grid.ColumnSpan="4" 
                        Width="150" Height="35" 
                        HorizontalAlignment="Center"
                        Margin="5" Background="#3D5736" Foreground="White" 
                        Click="AddButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица расхода материалов -->
        <Border Grid.Row="4" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <DataGrid x:Name="ConsumptionDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#D2D5AB"
                      RowBackground="White"
                      FontSize="14"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="Background" Value="#FDF0F4"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- ID - по центру -->
                    <DataGridTextColumn Header="ID" Binding="{Binding ConsumptionId}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Материал -->
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Количество - по правому краю -->
                    <DataGridTextColumn Header="Количество" Binding="{Binding MaterialConsumptionAmount}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ДАТА -->
                    <DataGridTextColumn Header="Дата" Binding="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ВРЕМЯ -->
                    <DataGridTextColumn Header="Время" Binding="{Binding AppointmentTime, StringFormat=hh\\:mm}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Действия -->
                    <DataGridTemplateColumn Header="Действия" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" 
                                        Width="30" Height="25"
                                        Background="#B35D6E" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="DeleteConsumptionButton_Click"
                                        Tag="{Binding ConsumptionId}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Итоговая информация -->
        <Border Grid.Row="5" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="10"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Общий расход по записи:" FontWeight="Bold" Margin="0,0,10,0" Foreground="#3D5736"/>
                <TextBlock x:Name="TotalConsumptionText" FontWeight="Bold" Foreground="#B35D6E"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>