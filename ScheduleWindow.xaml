<Window x:Class="LashAccountingSystem.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Календарь записей" 
        Height="600" Width="1216"
        Background="White"
        FontFamily="Roboto"
        Foreground="#4A6644"
        ResizeMode="CanResize"       
        WindowState="Normal">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Column="0" 
               Text="📅 Расписание записей" 
               FontSize="22" 
               FontWeight="Bold" 
               Foreground="#3D5736"
               VerticalAlignment="Center"/>

            <!-- Разделитель-отступ (визуально отделяет заголовок от кнопок) -->
            <Rectangle Grid.Column="1" Width="20" Height="1" Fill="Transparent"/>

            <!-- Группа: Управление системой -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BackupButton" 
                Content="💾 Резервное копирование" 
                Width="170" Height="30"
                Background="#3D5736" 
                Foreground="White"
                Click="BackupButton_Click"
                ToolTip="Создание и восстановление резервной копии"
                Margin="0,0,5,0"/>

                <Button x:Name="SettingsButton" 
                Content="⚙️ Настройки" 
                Width="100" Height="30"
                Background="#3D5736" 
                Foreground="White"
                Click="SettingsButton_Click"
                ToolTip="Настройки приложения"
                Margin="0,0,5,0"/>

                <Button x:Name="HelpButton" 
                Content="❓ Справка" 
                Width="90" Height="30"
                Background="#3D5736" 
                Foreground="White"
                Click="HelpButton_Click"
                ToolTip="Открыть руководство пользователя"/>
            </StackPanel>

            <!-- Разделитель-отступ -->
            <Rectangle Grid.Column="3" Width="15" Height="1" Fill="Transparent"/>

            <!-- Группа: Справочники -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="MastersButton" 
                Content="👥 Мастера" 
                Width="90" Height="30"
                Background="#8F9964" 
                Foreground="White"
                Click="MastersButton_Click"
                ToolTip="Управление мастерами"
                Margin="0,0,5,0"/>

                <Button x:Name="ExitButton" 
                Content="🚪 Выход" 
                Width="70" Height="30"
                Background="#B35D6E" 
                Foreground="White"
                Click="ExitButton_Click"
                ToolTip="Выход из приложения"/>
            </StackPanel>
        </Grid>

        <!-- Панель навигации по датам -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D7DAB3"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Кнопка "Назад" (вчера) -->
                <Button x:Name="PrevDayButton" 
                        Content="◀" 
                        Width="40" Height="30"
                        Background="#8F9964" 
                        Foreground="White"
                        FontSize="16" FontWeight="Bold"
                        Click="PrevDayButton_Click"
                        ToolTip="Предыдущий день"/>

                <!-- Текущая дата -->
                <TextBlock x:Name="CurrentDateText" 
                           Text="{Binding SelectedDate, ElementName=FilterDatePicker, StringFormat=dd.MM.yyyy}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#B35D6E"
                           VerticalAlignment="Center"
                           MinWidth="120"
                           TextAlignment="Center"/>

                <!-- Кнопка "Вперед" (завтра) -->
                <Button x:Name="NextDayButton" 
                        Content="▶" 
                        Width="40" Height="30"
                        Background="#8F9964" 
                        Foreground="White"
                        FontSize="16" FontWeight="Bold"
                        Click="NextDayButton_Click"
                        ToolTip="Следующий день"/>

                <Rectangle Width="1" Height="30" Fill="#D7DAB3" Margin="15,0"/>

                <!-- Выбор даты через календарь -->
                <TextBlock Text="Дата:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,0" 
                           FontWeight="Bold" Foreground="#3D5736" FontSize="16"/>

                <DatePicker x:Name="FilterDatePicker" 
                            SelectedDate="{x:Static sys:DateTime.Today}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="120"
                            Height="40"
                            FontSize="18"
                            SelectedDateChanged="FilterDatePicker_SelectedDateChanged" 
                            VerticalContentAlignment="Center" 
                            HorizontalContentAlignment="Center" 
                            Margin="0,0,0,5"/>

                <Button x:Name="TodayButton" Content="Сегодня" Width="80" Height="30" 
                        Margin="10,0,0,0" Background="#B35D6E" Foreground="White" 
                        Click="TodayButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="➕ Новая запись" Width="130" Height="35" 
                    Margin="0,0,10,0" Background="#3D5736" Foreground="White" 
                    Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="✏️ Редактировать" Width="120" Height="35" 
                    Margin="0,0,10,0" Background="#8F9964" Foreground="White"
                    Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="35" 
                    Margin="0,0,10,0" Background="#B35D6E" Foreground="White" 
                    Click="DeleteButton_Click"/>
            <Button x:Name="CompleteButton" Content="✓ Отметить выполненной" Width="160" Height="35" 
                    Margin="0,0,10,0" Background="#F5D1D8" Foreground="Black" 
                    Click="CompleteButton_Click"/>

            <Rectangle Width="2" Height="30" Fill="#D7DAB3" Margin="10,0"/>

            <Button x:Name="ClientsButton" Content="Клиенты" Width="100" Height="35" 
                    Margin="0,0,10,0" Background="#8F9964" Foreground="White" 
                    Click="ClientsButton_Click"/>
            <Button x:Name="ServicesButton" Content="Услуги" Width="100" Height="35" 
                    Margin="0,0,10,0" Background="#8F9964" Foreground="White" 
                    Click="ServicesButton_Click"/>
            <Button x:Name="MaterialsButton" Content="Материалы" Width="110" Height="35" 
                    Background="#8F9964" Foreground="White" 
                    Click="MaterialsButton_Click"/>
        </StackPanel>

        <!-- DataGrid с порядковым номером вместо ID -->
        <Border Grid.Row="3" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <DataGrid x:Name="MyDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#D2D5AB"
                      RowBackground="White"
                      FontSize="14"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="Background" Value="#FDF0F4"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#3D5736"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#D2D5AB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- ПОРЯДКОВЫЙ НОМЕР (вместо ID) -->
                    <DataGridTextColumn Header="№" Binding="{Binding DisplayOrder}" Width="45">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Время начала -->
                    <DataGridTemplateColumn Header="Начало" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AppointmentTime, StringFormat={}{0:hh\\:mm}}" 
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Foreground="#C66F80"
                                           MouseLeftButtonDown="StartTime_MouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Время окончания -->
                    <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat={}{0:hh\\:mm}}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Клиент -->
                    <DataGridTemplateColumn Header="Клиент" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ClientName}" 
                                           Cursor="Hand"
                                           Foreground="#3D5736"
                                           FontWeight="SemiBold"
                                           MouseLeftButtonDown="ClientName_MouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Услуга -->
                    <DataGridTemplateColumn Header="Услуга" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ServiceName}" 
                                           Cursor="Hand"
                                           Foreground="#3D5736"
                                           MouseLeftButtonDown="ServiceName_MouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Стоимость" Binding="{Binding ServicePrice, StringFormat={}{0:F2}}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Статус" Binding="{Binding AppointmentStatus}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#3D5736"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Выполнена">
                                        <Setter Property="Foreground" Value="#8F9964"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Отменена">
                                        <Setter Property="Foreground" Value="#B35D6E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AppointmentStatus}" Value="Не явка">
                                        <Setter Property="Foreground" Value="#C66F80"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Оплата -->
                    <DataGridTemplateColumn Header="Оплата" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Не оплачено"/>
                                            <Setter Property="Foreground" Value="#B35D6E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="True">
                                                    <Setter Property="Text" Value="Оплачено"/>
                                                    <Setter Property="Foreground" Value="#8F9964"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#3D5736"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>