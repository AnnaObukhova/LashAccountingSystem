<Window x:Class="LashAccountingSystem.AddAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Новая запись" 
        Height="620" Width="550"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Стиль для ReadOnly TextBox -->
        <Style TargetType="TextBox" x:Key="ReadOnlyTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#FDF0F4"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Новая запись" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Клиент -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Клиент:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <ComboBox x:Name="ClientComboBox" 
                  Grid.Row="1" Grid.Column="1" 
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="ClientId"/>

        <!-- Услуга -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Услуга:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <ComboBox x:Name="ServiceComboBox" 
                  Grid.Row="2" Grid.Column="1" 
                  DisplayMemberPath="ServiceName"
                  SelectedValuePath="ServiceId"
                  SelectionChanged="ServiceComboBox_SelectionChanged"/>

        <!-- Цена -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Цена:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="PriceTextBox" 
                 Grid.Row="3" Grid.Column="1" 
                 Height="35"
                 Style="{StaticResource ReadOnlyTextBox}"/>

        <!-- Мастер -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Мастер:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <ComboBox x:Name="MasterComboBox" 
                  Grid.Row="4" Grid.Column="1" 
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="MasterId"/>

        <!-- Дата -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Text="Дата:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <DatePicker x:Name="DatePicker" 
                    Grid.Row="5" Grid.Column="1"
                    SelectedDate="{x:Static sys:DateTime.Today}"/>

        <!-- Время -->
        <TextBlock Grid.Row="6" Grid.Column="0" 
                   Text="Время:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <ComboBox x:Name="TimeComboBox" 
                  Grid.Row="6" Grid.Column="1"
                  IsEditable="True">
            <ComboBoxItem Content="09:00"/>
            <ComboBoxItem Content="09:30"/>
            <ComboBoxItem Content="10:00"/>
            <ComboBoxItem Content="10:30"/>
            <ComboBoxItem Content="11:00"/>
            <ComboBoxItem Content="11:30"/>
            <ComboBoxItem Content="12:00"/>
            <ComboBoxItem Content="12:30"/>
            <ComboBoxItem Content="13:00"/>
            <ComboBoxItem Content="13:30"/>
            <ComboBoxItem Content="14:00"/>
            <ComboBoxItem Content="14:30"/>
            <ComboBoxItem Content="15:00"/>
            <ComboBoxItem Content="15:30"/>
            <ComboBoxItem Content="16:00"/>
            <ComboBoxItem Content="16:30"/>
            <ComboBoxItem Content="17:00"/>
            <ComboBoxItem Content="17:30"/>
            <ComboBoxItem Content="18:00"/>
            <ComboBoxItem Content="18:30"/>
            <ComboBoxItem Content="19:00"/>
        </ComboBox>

        <!-- Примечания -->
        <TextBlock Grid.Row="7" Grid.Column="0" 
                   Text="Примечания:" 
                   VerticalAlignment="Top" 
                   Margin="5"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <TextBox x:Name="NotesTextBox" 
                 Grid.Row="7" Grid.Column="1" 
                 Height="80" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Оплата -->
        <TextBlock Grid.Row="8" Grid.Column="0" 
                   Text="Оплата:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   Foreground="#3D5736"
                   FontSize="14"/>
        <CheckBox x:Name="PaymentCheckBox" 
                  Grid.Row="8" Grid.Column="1" 
                  Margin="5" 
                  Content="Оплачено"
                  VerticalAlignment="Center"
                  Foreground="#3D5736"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="100" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="100" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>