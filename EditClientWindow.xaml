<Window x:Class="LashAccountingSystem.EditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование клиента" 
        Height="608" Width="700"
        Background="White"
        FontFamily="Roboto"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для всех кнопок с закруглёнными углами -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D2D5AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D5736"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ReadOnlyTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#FDF0F4"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Редактирование клиента" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Панель с информацией о клиенте (поля для редактирования) -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="12" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#D2D5AB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ID (только для чтения) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Height="35" Style="{StaticResource ReadOnlyTextBox}"/>

                <!-- Фамилия -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Фамилия:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="SurnameTextBox" Grid.Row="1" Grid.Column="1" Margin="5" Height="35"/>

                <!-- Имя -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Имя:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Margin="5" Height="35"/>

                <!-- Отчество -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Отчество:" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="PatronymicTextBox" Grid.Row="3" Grid.Column="1" Margin="5" Height="35"/>

                <!-- Телефон -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Телефон:" FontWeight="Bold" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="PhoneTextBox" Grid.Row="4" Grid.Column="1" Margin="5" Height="35"/>

                <!-- Email -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Email:" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="EmailTextBox" Grid.Row="5" Grid.Column="1" Margin="5" Height="35"/>

                <!-- Примечания -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечания:" Margin="5" Foreground="#3D5736" FontSize="14"/>
                <TextBox x:Name="NotesTextBox" Grid.Row="6" Grid.Column="1" Margin="5" Height="80" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3" 
                   Text="ℹ️ Поля, выделенные жирным, обязательны для заполнения" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>