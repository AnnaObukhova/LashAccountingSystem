<Window x:Class="LashAccountingSystem.AddEditMasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/Редактирование мастера" 
        Height="550" Width="500"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   x:Name="TitleText"
                   Text="➕ Добавление мастера" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Фамилия -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Фамилия:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <TextBox x:Name="SurnameTextBox" Grid.Row="1" Grid.Column="1" Height="35"/>

        <!-- Имя -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Имя:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Height="35"/>

        <!-- Отчество -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Отчество:" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontSize="14"/>
        <TextBox x:Name="PatronymicTextBox" Grid.Row="3" Grid.Column="1" Height="35"/>

        <!-- Телефон -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Телефон:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <TextBox x:Name="PhoneTextBox" Grid.Row="4" Grid.Column="1" Height="35"/>

        <!-- Номер договора -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Text="Номер договора:*" 
                   VerticalAlignment="Center" 
                   Margin="5" 
                   FontWeight="Bold"
                   FontSize="14"/>
        <TextBox x:Name="ContractNumberTextBox" Grid.Row="5" Grid.Column="1" Height="35"/>

        <!-- Специализация -->
        <TextBlock Grid.Row="6" Grid.Column="0" 
                   Text="Специализация:" 
                   VerticalAlignment="Top" 
                   Margin="5" 
                   FontSize="14"/>
        <TextBox x:Name="SpecializationTextBox" 
                 Grid.Row="6" Grid.Column="1" 
                 Height="60" 
                 TextWrapping="Wrap"
                 AcceptsReturn="True"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="💾 Сохранить" Width="100" Height="35" Margin="10" 
                    Background="#3D5736" Foreground="White" 
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" Width="100" Height="35" Margin="10" 
                    Background="#B35D6E" Foreground="White" 
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" 
                   Text="* — обязательные поля" 
                   FontSize="10" 
                   Foreground="#999999" 
                   Margin="5" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>