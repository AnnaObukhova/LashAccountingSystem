<Window x:Class="LashAccountingSystem.MaterialReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="📊 Отчёт по расходу материалов" 
        Height="550" Width="850"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📊 Отчёт по расходу материалов" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Панель фильтров -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D7DAB3"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Период:" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           Margin="5"/>

                <DatePicker x:Name="StartDatePicker" Width="120"/>
                <TextBlock Text="—" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="EndDatePicker" Width="120"/>

                <Button x:Name="ShowReportButton" 
                        Content="📊 Показать отчёт" 
                        Width="130" 
                        Margin="15,0,0,0"
                        Background="#3D5736" 
                        Foreground="White"
                        Click="ShowReportButton_Click"/>

                <Button x:Name="ExportCsvButton" 
                        Content="📎 Экспорт в CSV" 
                        Width="120" 
                        Margin="10,0,0,0"
                        Background="#8F9964" 
                        Foreground="White"
                        Click="ExportCsvButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Итоговая информация -->
        <Border Grid.Row="2" 
                Background="#E8F5E9" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#A5D6A7"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TotalMaterialsCount" 
                           Text="📦 Всего материалов: 0" 
                           Margin="20,0" 
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalQuantity" 
                           Text="🔢 Общий расход: 0 ед." 
                           Margin="20,0" 
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalCost" 
                           Text="💰 Общая стоимость: 0 руб." 
                           Margin="20,0" 
                           FontWeight="SemiBold"
                           Foreground="#B35D6E"/>
            </StackPanel>
        </Border>

        <!-- Таблица расхода материалов -->
        <Border Grid.Row="3" BorderBrush="#D2D5AB" BorderThickness="1" Background="White">
            <DataGrid x:Name="ReportDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#D2D5AB"
                      RowBackground="White"
                      FontSize="13"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="180"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="Расход (ед.)" Binding="{Binding TotalQuantity}" Width="100"/>
                    <DataGridTextColumn Header="Цена продажи" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90"/>

                    <!-- НОВЫЕ КОЛОНКИ -->
                    <DataGridTextColumn Header="Последний приход" Binding="{Binding LastIncomingDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding LastSupplier}" Width="120"/>
                    <DataGridTextColumn Header="Цена закупки" Binding="{Binding LastIncomingPrice, StringFormat={}{0:F2}}" Width="90"/>
                    <DataGridTextColumn Header="Складской остаток" Binding="{Binding CurrentStock, StringFormat={}{0:F2}}" Width="100"/>

                    <DataGridTextColumn Header="Общая стоимость (руб)" Binding="{Binding TotalCost, StringFormat={}{0:F2}}" Width="120"/>
                    <DataGridTextColumn Header="Кол-во записей" Binding="{Binding AppointmentCount}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>