<Window x:Class="LashAccountingSystem.MaterialReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="📊 Отчёт по движению материалов" 
        Height="550" Width="900"
        Background="White"
        FontFamily="Segoe UI"
        Foreground="#3D5736"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📊 Отчёт по движению материалов" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#3D5736"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Панель фильтров -->
        <Border Grid.Row="1" 
                Background="#FDF0F4" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,10"
                BorderBrush="#D7DAB3"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Период:" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           Margin="5"/>

                <DatePicker x:Name="StartDatePicker" Width="120"/>
                <TextBlock Text="—" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="EndDatePicker" Width="120"/>

                <Button x:Name="ShowReportButton" 
                        Content="📊 Показать отчёт" 
                        Width="130" 
                        Margin="15,0,0,0"
                        Background="#3D5736" 
                        Foreground="White"
                        Click="ShowReportButton_Click"/>

                <Button x:Name="ExportCsvButton" 
                        Content="📎 Экспорт в CSV" 
                        Width="120" 
                        Margin="10,0,0,0"
                        Background="#8F9964" 
                        Foreground="White"
                        Click="ExportCsvButton_Click"/>

                <Button x:Name="ExportPdfButton" 
                        Content="📄 Экспорт в PDF" 
                        Width="120" 
                        Margin="10,0,0,0"
                        Background="#B35D6E" 
                        Foreground="White"
                        Click="ExportPdfButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Три вкладки -->
        <TabControl Grid.Row="2">

            <!-- Вкладка 1: Приход -->
            <TabItem Header="📦 Приход материалов">
                <DataGrid x:Name="IncomingDataGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#D2D5AB"
                          RowBackground="White"
                          FontSize="13"
                          BorderBrush="Transparent"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="200"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                        <DataGridTextColumn Header="Цена покупки" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="120"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Общая стоимость" Binding="{Binding Total, StringFormat={}{0:F2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Расход -->
            <TabItem Header="💰 Расход материалов">
                <DataGrid x:Name="OutgoingDataGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#D2D5AB"
                          RowBackground="White"
                          FontSize="13"
                          BorderBrush="Transparent"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="200"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                        <DataGridTextColumn Header="Цена продажи" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="120"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Общая стоимость" Binding="{Binding Total, StringFormat={}{0:F2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 3: Сводка -->
            <TabItem Header="📊 Сводная ведомость">
                <DataGrid x:Name="SummaryDataGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#D2D5AB"
                          RowBackground="White"
                          FontSize="13"
                          BorderBrush="Transparent"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="200"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                        <DataGridTextColumn Header="Приход" Binding="{Binding Incoming, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Расход" Binding="{Binding Outgoing, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Ср. цена закупки" Binding="{Binding AvgPrice, StringFormat={}{0:F2}}" Width="120"/>
                        <DataGridTextColumn Header="Стоимость остатка" Binding="{Binding StockValue, StringFormat={}{0:F2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>